# Copy to .env and fill in. Never commit .env.

# Server
PORT=8080
HOST=127.0.0.1

# Location for prayer-time calculation (adhan). Also set the Pi's timezone to match:
#   sudo raspi-config nonint do_change_timezone America/New_York
LATITUDE=33.7490
LONGITUDE=-84.3880
# Optional: show prayer times in this IANA timezone instead of the system one.
TIMEZONE=

# Quran recitation: extra options for mpv, the audio player (space-separated). Leave empty to use
# the system's default speaker. Example, to pick one: --audio-device=alsa/plughw:CARD=Device,DEV=0
# (list them with: mpv --audio-device=help)
RECITATION_MPV_ARGS=

# Spotify (https://developer.spotify.com/dashboard)
# Redirect URI to register: http://127.0.0.1:8080/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Personal calendar (right side of the Haram page). Google Calendar → Settings → your calendar →
# "Secret address in iCal format". It works like a password: keep it here, never commit it.
# Several calendars: separate the links with commas.
CALENDAR_ICS=

# Deploy target used by scripts/deploy.sh
PI_HOST=pi@raspberrypi.local
PI_DIR=/home/pi/rpi-dashboard
